# 개발 중 포털(/dashboard) 로그인 확인 건너뛰기 (모든 서비스 데모 계정으로 보임, 운영에서는 무시)
PORTAL_AUTH_BYPASS=1

# 로그인 세션 서명 키 (운영 필수, 긴 무작위 문자열)
SESSION_SECRET=

# 운영에서 데모 계정 로그인 허용 (토스 심사 기간 등). 개발 환경에서는 항상 허용.
# 로그인 화면의 데모 계정 안내는 빌드 때 정해지므로 빌드와 실행 모두에 설정한다
DEMO_LOGIN=

# 중앙 코어 서버 (고객사 인스턴스 상태·사용량)
CORE_API_URL=

# 토스페이먼츠
NEXT_PUBLIC_TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# 문의·견적 접수 알림을 받을 주소 (슬랙 웹훅, 메일 자동화 등). 운영에서 비어 있으면 접수가 막힌다
INQUIRY_WEBHOOK_URL=
