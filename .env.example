# 개발 중 포털(/dashboard) 로그인 확인 건너뛰기 (모든 서비스 데모 계정으로 보임, 운영에서는 무시)
PORTAL_AUTH_BYPASS=1

# 로그인 세션 서명 키 (운영 필수, 긴 무작위 문자열)
SESSION_SECRET=

# 운영에서 데모 계정 로그인 허용 (토스 심사 기간 등). 개발 환경에서는 항상 허용.
# 로그인 화면의 데모 계정 안내는 빌드 때 정해지므로 빌드와 실행 모두에 설정한다
DEMO_LOGIN=

# 중앙 코어 서버 (고객사 인스턴스 상태·사용량)
CORE_API_URL=

# 토스페이먼츠
NEXT_PUBLIC_TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# 문의·견적 접수 알림을 받을 주소 (슬랙 웹훅, 메일 자동화 등). 운영에서 비어 있으면 접수가 막힌다
INQUIRY_WEBHOOK_URL=

# 간편 로그인 (카카오·네이버). 비어 있으면 그 버튼은 "설정되지 않음" 안내로 돌아간다
# 각 콘솔에 Redirect URI 등록: {사이트 주소}/auth/kakao/callback, {사이트 주소}/auth/naver/callback
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# 프록시 뒤 등에서 사이트 주소가 다르게 잡힐 때만 지정 (예: https://saffir.co.kr)
AUTH_ORIGIN=

# ───────── 백엔드 (server/: NestJS + PostgreSQL) ─────────
# 실행: docker compose -f docker-compose.dev.yml up server db  (자세한 건 docs/backend-setup.md)

# 데이터 출처 스위치. 비워 두면 데모 데이터(백엔드 없이 화면만, Vercel 미리보기),
# 넣으면 백엔드에서 실제 데이터를 가져온다. 로컬: http://localhost:4000 · Docker 안: http://server:4000
API_URL=

# PostgreSQL
POSTGRES_USER=saffir
POSTGRES_PASSWORD=saffir_pw
POSTGRES_DB=saffir
DATABASE_URL=postgresql://saffir:saffir_pw@localhost:5432/saffir

# 백엔드 인증 (JWT 쿠키). OAuth 콜백을 받을 백엔드 주소
JWT_SECRET=
CALLBACK_BASE_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000
# 아래 OAuth 값은 백엔드 시작 때 필수다. 키가 없을 때 로컬에서는 아무 글자나 넣어 두면 서버는 뜬다 (해당 로그인만 안 됨)
# 카카오 KAKAO_CLIENT_ID는 위 KAKAO_REST_API_KEY와 같은 값, KAKAO_CLIENT_SECRET·NAVER_*는 위 값을 같이 쓴다
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KAKAO_CLIENT_ID=
# 토스페이먼츠 (백엔드가 결제 승인에 쓴다. 위 NEXT_PUBLIC_TOSS_CLIENT_KEY와 같은 값)
TOSS_CLIENT_KEY=

# 메일 (문의 알림·비밀번호 재설정). 비어 있으면 알림 없이 동작하고 재설정 링크는 서버 로그에 찍힌다
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
NOTIFY_EMAIL=
